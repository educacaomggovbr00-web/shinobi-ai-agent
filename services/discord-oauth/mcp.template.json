{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bushin-browser": {
      "type": "streamable-http",
      "url": "https://REPLACE-WITH-A-REAL-HTTPS-HOST.example/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "identify",
              "guilds",
              "guilds.members.read"
            ]
          }
        }
      }
    }
  }
}
